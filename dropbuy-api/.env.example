# SQLite cho dev. Đổi sang Postgres: sửa provider trong prisma/schema.prisma thành "postgresql"
# và đặt DATABASE_URL="postgresql://user:pass@host:5432/dropbuy"
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Tenant mặc định (site gốc) – fx_hash dùng trong các path /bff/<group>/{fx_hash}/...
DEFAULT_TENANT_FX_HASH="afa4cf0301eb4a75882dd5df30cc54a5"
