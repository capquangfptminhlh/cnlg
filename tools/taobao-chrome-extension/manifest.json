{
  "manifest_version": 3,
  "name": "BESI Taobao · Kiểm tra phí ship",
  "version": "0.2.0",
  "description": "Read confirmed shipping from Taobao and, with explicit operator permission, sync visible Taobao catalog/stock observations to BESI staging while browsing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.taobao.com/*",
    "https://besi.com.vn/*"
  ],
  "action": {
    "default_title": "BESI · Taobao Shipping",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "catalog-background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.taobao.com/*"
      ],
      "js": [
        "catalog-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
