# Cổng chạy storefront
HOANGMINH_PORT=3000
# Mật khẩu vào trang quản trị /admin.html (nếu bỏ trống, server tự sinh và lưu ở data/admin-secret.json)
ADMIN_PASSWORD=
# Địa chỉ công khai của cửa hàng (link chia sẻ, sitemap, ảnh xem trước). Vd: https://shop.ten-mien.com
PUBLIC_BASE_URL=
# Đặt 1 khi chạy sau Cloudflare Tunnel / nginx / Caddy để lấy đúng IP khách
TRUST_PROXY=
# Khoá mã hoá tài khoản DropBuy đã lưu (64 ký tự hex). Bỏ trống = tự sinh data/cred.key
DROPBUY_CRED_KEY=
# Cho phép domain khác gọi API (để trống = chỉ cùng origin)
CORS_ORIGIN=
# Bot tự đặt hàng trên DropBuy bằng trình duyệt headless – CHƯA kiểm thử đầu-cuối, đặt hàng bằng tiền thật. Mặc định tắt.
RELAY_LIVE_BOT=false
# Tuỳ chọn: đẩy giá niêm yết mới sang DB của bản clone dropbuy-api
DROPBUY_API_DIR=
# Chu kỳ đồng bộ realtime (giây)
STOCK_SYNC_SECONDS=30
PRICE_SYNC_SECONDS=600
# Thanh toán tự động qua webhook ngân hàng (chọn 1)
SEPAY_WEBHOOK_KEY=
CASSO_SECURE_TOKEN=
# Báo đơn mới / tiền về qua Telegram (tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cache trang chi tiết sản phẩm (giờ)
DETAIL_CACHE_HOURS=6


# ── Taobao: tab nguồn hàng riêng, chỉ dùng API/feed được cấp quyền ──
# Không điền khoá thật vào GitHub. Cấu hình trong .env riêng trên Windows origin.
TAOBAO_DATA_PERMISSION=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
# Model Ollama phải có sẵn tại máy local; tên model cụ thể tùy môi trường.
TAOBAO_LOCAL_MODEL=
# Bật đồng bộ giá/danh mục theo API (mặc định TẮT, chỉ khi có đủ quyền dữ liệu).
TAOBAO_AUTO_SYNC=0
TAOBAO_AUTO_SYNC_KEYWORDS=
TAOBAO_PAGES_PER_KEYWORD=2
TAOBAO_SYNC_INTERVAL_HOURS=12
# FX CNY/VND từ ExchangeRate-API, tự cập nhật tham khảo mỗi 12 giờ.
TAOBAO_FX_AUTO_REFRESH=1
